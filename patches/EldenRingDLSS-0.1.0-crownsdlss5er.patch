 // --- DLSS --------------------------------------------------------------------------------------------------
 
+// ReShade's D3D12 proxies derive from the COM interface first and the add-on API object second, so the interface
+// pointer sits one vtable pointer before the API object. NGX gets the proxies, the objects the game itself uses:
+// OptiScaler's neural rendering creates descriptor heaps through ReShade's proxy device, and binding those
+// (ReShade-wrapped) heaps on the unwrapped command list crashes in D3D12. A candidate is accepted only when both
+// vtables live in the same module (ReShade) and it answers QueryInterface with itself.
+template <typename T>
+T* ReshadeProxy(void* api_object) {
+  constexpr DWORD kFlags = GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT;
+  void* const candidate = static_cast<char*>(api_object) - sizeof(void*);
+  HMODULE api_module = nullptr, com_module = nullptr;
+  if (!GetModuleHandleExW(kFlags, static_cast<LPCWSTR>(*static_cast<void**>(api_object)), &api_module) ||
+      !GetModuleHandleExW(kFlags, static_cast<LPCWSTR>(*static_cast<void**>(candidate)), &com_module) ||
+      api_module != com_module)
+    return nullptr;
+  T* queried = nullptr;
+  if (FAILED(static_cast<IUnknown*>(candidate)->QueryInterface(IID_PPV_ARGS(&queried))) || queried == nullptr)
+    return nullptr;
+  queried->Release();
+  return static_cast<void*>(queried) == candidate ? queried : nullptr;
+}
+
+// The command list NGX records into: ReShade's proxy when it can be found, else the native list.
+ID3D12GraphicsCommandList* NgxList(command_list* cmd_list, ID3D12GraphicsCommandList* native) {
+  ID3D12GraphicsCommandList* const proxy = ReshadeProxy<ID3D12GraphicsCommandList>(cmd_list);
+  static std::atomic<bool> logged{false};
+  if (!logged.exchange(true))
+    Log(reshade::log::level::info, proxy != nullptr ? "NGX records into ReShade's command list proxies."
+                                                    : "ReShade command list proxy not found; NGX uses native lists.");
+  return proxy != nullptr ? proxy : native;
+}
+
+// NGX must run on the device that owns the game's command lists. Under ReShade plus another D3D12 hook the add-on's
+// device can be a different object for the same GPU; models that create their own D3D12 objects then crash. Called
+// with g_dlss_mutex held, before a feature is created.
+void MatchNgxDevice(ID3D12GraphicsCommandList* cmd) {
+  ID3D12Device* list_device = nullptr;
+  if (FAILED(cmd->GetDevice(IID_PPV_ARGS(&list_device))) || list_device == nullptr) return;
+  if (list_device != g_dlss.device()) {
+    char text[160];
+    std::snprintf(text, sizeof(text), "NGX device %p differs from the command list's device %p; re-initializing NGX on it.",
+                  static_cast<void*>(g_dlss.device()), static_cast<void*>(list_device));
+    Log(reshade::log::level::warning, text);
+    g_dlss.Shutdown();
+    const fs::path log_dir = g_addon_dir / L"ngx";
+    if (!g_dlss.Init(list_device, g_addon_dir.wstring(), log_dir.wstring()))
+      Log(reshade::log::level::warning, "DLSS unavailable on the command list's device: " + g_dlss.status());
+  }
+  list_device->Release();
+}
