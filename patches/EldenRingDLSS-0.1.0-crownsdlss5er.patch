-void OnDestroyDevice(device* dev) {
-  if (dev != g_device) return;
+void OnInitDevice(device* dev) {
+  if (dev->get_api() != device_api::d3d12) return;
+  {
+    std::lock_guard lock(g_devices_mutex);
+    g_d3d12_devices.push_back(dev);
+  }
+  if (g_device == nullptr) BindDevice(dev);
+}
+
+void UnbindDevice(device* dev) {
   std::lock_guard lock(g_dlss_mutex);
   RetireOutput();
   for (const Retired& r : g_retired) dev->destroy_resource(r.res);
@@ -1816,6 +1909,21 @@
   g_device = nullptr;
 }
 
+void OnDestroyDevice(device* dev) {
+  device* next = nullptr;
+  {
+    std::lock_guard lock(g_devices_mutex);
+    std::erase(g_d3d12_devices, dev);
+    if (dev == g_device && !g_d3d12_devices.empty()) next = g_d3d12_devices.back();
+  }
+  if (dev != g_device) return;
+  UnbindDevice(dev);
+  if (next != nullptr) {
+    Log(reshade::log::level::info, "The D3D12 device DLSS was set up on was destroyed; moving to the remaining one.");
+    BindDevice(next);
+  }
+}
