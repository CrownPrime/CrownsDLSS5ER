+// CrownPrime branding: the emblem (gold diamond with crown, chevrons and heart) drawn with ImGui shapes, so it
+// needs no texture and renders the same on every graphics API.
+static void DrawCrownPrimeEmblem(ImDrawList* dl, ImVec2 o, float h, ImU32 gold, ImU32 dark)
+{
+    const float w = h * 0.60f;
+    auto P = [&](float x, float y) { return ImVec2(o.x + x * w, o.y + y * h); };
+    auto Line = [&](std::initializer_list<ImVec2> pts, float f, bool closed)
+    {
+        std::vector<ImVec2> v(pts);
+        dl->AddPolyline(v.data(), (int) v.size(), gold, closed ? ImDrawFlags_Closed : ImDrawFlags_None,
+                        std::max(1.0f, h * f));
+    };
+    auto Quad = [&](ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 d, ImU32 col)
+    {
+        ImVec2 q[4] = { a, b, c, d };
+        dl->AddConvexPolyFilled(q, 4, col);
+    };
+
+    // Double diamond.
+    Quad(P(0.50f, 0.00f), P(1.00f, 0.47f), P(0.50f, 1.00f), P(0.00f, 0.47f), dark);
+    Line({ P(0.50f, 0.00f), P(1.00f, 0.47f), P(0.50f, 1.00f), P(0.00f, 0.47f) }, 0.035f, true);
+    Line({ P(0.50f, 0.07f), P(0.92f, 0.47f), P(0.50f, 0.93f), P(0.08f, 0.47f) }, 0.014f, true);
+
+    // Crown: V-bottomed band, horns reaching past the diamond, two bumps, centre spire and star.
+    ImVec2 band[5] = { P(0.10f, 0.40f), P(0.90f, 0.40f), P(0.84f, 0.46f), P(0.50f, 0.54f), P(0.16f, 0.46f) };
+    dl->AddConvexPolyFilled(band, 5, gold);
+    dl->AddTriangleFilled(P(0.10f, 0.41f), P(0.27f, 0.41f), P(0.00f, 0.29f), gold);
+    dl->AddTriangleFilled(P(0.73f, 0.41f), P(0.90f, 0.41f), P(1.00f, 0.29f), gold);
+    dl->AddTriangleFilled(P(0.24f, 0.41f), P(0.38f, 0.41f), P(0.31f, 0.33f), gold);
+    dl->AddTriangleFilled(P(0.62f, 0.41f), P(0.76f, 0.41f), P(0.69f, 0.33f), gold);
+    dl->AddTriangleFilled(P(0.42f, 0.41f), P(0.58f, 0.41f), P(0.50f, 0.24f), gold);
+    Quad(P(0.50f, 0.15f), P(0.535f, 0.205f), P(0.50f, 0.26f), P(0.465f, 0.205f), gold);
+    Quad(P(0.43f, 0.205f), P(0.50f, 0.19f), P(0.57f, 0.205f), P(0.50f, 0.22f), gold);
+    for (float x : { 0.38f, 0.50f, 0.62f })
+        dl->AddCircleFilled(P(x, 0.445f), h * 0.016f, dark);
+
+    // Chevrons under the crown.
+    Line({ P(0.14f, 0.52f), P(0.50f, 0.615f), P(0.86f, 0.52f) }, 0.018f, false);
+    Line({ P(0.20f, 0.575f), P(0.50f, 0.67f), P(0.80f, 0.575f) }, 0.014f, false);
+
+    // Inner diamond holding the heart.
+    Line({ P(0.50f, 0.66f), P(0.68f, 0.775f), P(0.50f, 0.89f), P(0.32f, 0.775f) }, 0.013f, true);
+    const float r = h * 0.028f;
+    const ImVec2 l = P(0.465f, 0.765f), rr = P(0.535f, 0.765f);
+    dl->AddCircleFilled(l, r, gold);
+    dl->AddCircleFilled(rr, r, gold);
+    dl->AddTriangleFilled(ImVec2(l.x - r, l.y + r * 0.3f), ImVec2(rr.x + r, rr.y + r * 0.3f), P(0.50f, 0.835f), gold);
+}
+
+// Header row at the top of the main menu: emblem, CrownsDLSS5ER and a short subtitle.
+static void RenderCrownPrimeHeader()
+{
+    const float fontSize = ImGui::GetFontSize();
+    const float h = fontSize * 3.2f;
+    const ImU32 gold = IM_COL32(212, 168, 83, 255);
+    const ImVec2 o = ImGui::GetCursorScreenPos();
+    DrawCrownPrimeEmblem(ImGui::GetWindowDrawList(), o, h, gold, IM_COL32(10, 9, 8, 255));
+    ImGui::Dummy(ImVec2(h * 0.60f, h));
+    ImGui::SameLine(0.0f, ImGui::GetStyle().ItemSpacing.x * 2.0f);
+
+    ImGui::BeginGroup();
+    ImGui::SetCursorPosY(ImGui::GetCursorPosY() + h * 0.10f);
+    ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(0.83f, 0.66f, 0.33f, 1.00f));
+    ImGui::PushFontSize(std::round(fontSize * 1.7f));
+    ImGui::TextUnformatted("CrownsDLSS5ER");
+    ImGui::PopFontSize();
+    ImGui::PopStyleColor();
+    ImGui::TextDisabled("DLSS 5 neural rendering  |  powered by OptiScaler");
+    ImGui::EndGroup();
+    ImGui::Separator();
+}
+
 static std::string selectedUpscalerName = "";
 static Upscaler currentBackend = Upscaler::Reset;
